# Control structure: rolloutSystem. Generated by tools/control_structure.py from the SysML v2 model; do not edit.
# Render with the d2 tool (https://d2lang.com):  d2 THIS_FILE.d2 OUTPUT.svg

vars: {
  d2-config: {layout-engine: elk}
  d2-legend: {
    l1: "controller" {class: controller}
    l2: "actuator / sensor" {class: interface}
    l3: "process" {class: process}
    l4: "" {style.opacity: 0}
    l5: "" {style.opacity: 0}
    l6: "" {style.opacity: 0}
    l7: "" {style.opacity: 0}
    l4 -> l5: control action {class: control-action}
    l6 -> l7: feedback {class: feedback}
  }
}
classes: {
  controller: {style: {stroke: "#2a78d6"; stroke-width: 2; fill: "#fcfcfb"; font-color: "#0b0b0b"; border-radius: 4}}
  interface: {style: {stroke: "#eb6834"; stroke-width: 2; fill: "#fcfcfb"; font-color: "#0b0b0b"; border-radius: 4}}
  process: {style: {stroke: "#1baf7a"; stroke-width: 2; fill: "#fcfcfb"; font-color: "#0b0b0b"; border-radius: 4}}
  undeclared: {style: {stroke: "#8a8984"; stroke-width: 2; fill: "#fcfcfb"; font-color: "#0b0b0b"; border-radius: 4; stroke-dash: 3}}
  control-action: {style: {stroke: "#52514e"; font-color: "#0b0b0b"; font-size: 12}}
  feedback: {style: {stroke: "#52514e"; font-color: "#0b0b0b"; font-size: 12; stroke-dash: 4}}
  pin: {style: {opacity: 0}}
}
title: "Control structure: rolloutSystem" {shape: text; near: top-center; style: {font-size: 20; bold: true}}
direction: down

n_rolloutController: "rolloutController\ncontroller" {class: controller}
n_batch: "batch\nprocess" {class: process}

n_rolloutController -> n_batch: "pushConfig\nrollback" {class: control-action}
n_rolloutController <- n_batch: "healthReport\nerrorRate" {class: feedback}
